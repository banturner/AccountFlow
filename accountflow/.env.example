# ── Database ──────────────────────────────────────────────
POSTGRES_DB=accountflow
POSTGRES_USER=accountflow
POSTGRES_PASSWORD=changeme_strong_password
DATABASE_URL=postgresql+asyncpg://accountflow:changeme_strong_password@db:5432/accountflow

# ── Redis ─────────────────────────────────────────────────
REDIS_PASSWORD=changeme_redis_password
REDIS_URL=redis://:changeme_redis_password@redis:6379/0

# ── Security ──────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=your_fernet_key_here

# INTERNAL admin/ops key — used only for tenant management endpoints.
# Tenant-facing auth is JWT (see JWT_SECRET_KEY).
DASHBOARD_API_KEY=changeme_admin_key

# JWT signing key for tenant logins.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=changeme_jwt_secret
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# ── Anthropic ─────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# AI confidence threshold — drafts above this are auto-queued; below → flagged for review
AI_CONFIDENCE_THRESHOLD=0.85

# ── Google OAuth (Gmail + Calendar) ───────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Must match the redirect URI registered in Google Cloud Console
GOOGLE_REDIRECT_URI=https://yourdomain.com/api/auth/google/callback

# ── Microsoft 365 / Outlook (optional) ────────────────────
# Leave blank for a Google-only deployment. See OAUTH_DECISION_TESTS.md Test B.
# Unlike Gmail, Graph mail access needs NO annual third-party security audit.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://yourdomain.com/api/auth/microsoft/callback
# "common" lets any Microsoft 365 tenant consent; pin to a tenant id to lock
# the app to a single organisation.
MICROSOFT_AUTHORITY=https://login.microsoftonline.com/common

# ── SendGrid ──────────────────────────────────────────────
SENDGRID_API_KEY=SG.xxx
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_FROM_NAME=AccountFlow

# ── Sentry ────────────────────────────────────────────────
SENTRY_DSN=https://xxx@sentry.io/xxx

# ── App ───────────────────────────────────────────────────
ENVIRONMENT=production
# How often to poll Gmail (seconds)
GMAIL_POLL_INTERVAL=120
# Max messages fetched per tenant per poll cycle
GMAIL_MAX_RESULTS=50
# Base URL for OAuth callbacks AND emailed draft-review links.
# Must be an address the business owner can actually open in a browser —
# if this is wrong, every "Reply ready" email contains a dead link.
APP_BASE_URL=https://yourdomain.com

# How many days an emailed draft-review link stays valid
REVIEW_LINK_DAYS=7
